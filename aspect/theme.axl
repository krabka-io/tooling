"""The Krabka look for the pages `rustdoc-site` publishes.

Every value here is a pure function or a constant, so the unit tests compare
whole results. The palette is the one krabka.io uses: a dark navy page, a
vermilion accent, Inter for text and JetBrains Mono for code.
"""

_FONTS_URL = "https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"

# `apply_rustdoc_theme` writes this comment before the override. A second call
# finds the comment and knows that the theme is already in place.
_MARKER = "/* krabka-theme */"

_LOGO_SVG = """<svg viewBox="0 0 90 90" width="100%" height="100%" fill="none" xmlns="http://www.w3.org/2000/svg"><g transform="matrix(1.2410837,0,0,1.2410837,-10.847205,1.7895666)"><ellipse style="fill:none;stroke:#FF4D2E;stroke-width:7.6591;stroke-dasharray:none" cx="45" cy="45" rx="13.749256" ry="8.6910944"/><g><circle style="fill:none;stroke:#FF4D2E;stroke-width:5.01105;stroke-dasharray:none" cx="31.509378" cy="21.770279" r="7.1520071"/><path style="fill:none;stroke:#FF4D2E;stroke-width:5.01105;stroke-dasharray:none" d="m -37.432668,-19.054935 a 7.1520071,7.1520071 0 0 1 -4.415052,6.607593 7.1520071,7.1520071 0 0 1 -7.794188,-1.550361 7.1520071,7.1520071 0 0 1 -1.55036,-7.794187 7.1520071,7.1520071 0 0 1 6.607593,-4.415053" transform="rotate(-135)"/><rect style="fill:#FF4D2E;stroke:none;stroke-width:5.29167;stroke-dasharray:none" width="4.4989443" height="12.777002" x="14.19296" y="41.136307" transform="rotate(-30)"/></g><g transform="matrix(-1,0,0,1,89.997483,0)"><circle style="fill:none;stroke:#FF4D2E;stroke-width:5.01105;stroke-dasharray:none" cx="31.509378" cy="21.770279" r="7.1520071"/><path style="fill:none;stroke:#FF4D2E;stroke-width:5.01105;stroke-dasharray:none" d="m -37.432668,-19.054935 a 7.1520071,7.1520071 0 0 1 -4.415052,6.607593 7.1520071,7.1520071 0 0 1 -7.794188,-1.550361 7.1520071,7.1520071 0 0 1 -1.55036,-7.794187 7.1520071,7.1520071 0 0 1 6.607593,-4.415053" transform="rotate(-135)"/><rect style="fill:#FF4D2E;stroke:none;stroke-width:5.29167;stroke-dasharray:none" width="4.4989443" height="12.777002" x="14.19296" y="41.136307" transform="rotate(-30)"/></g></g></svg>"""

_LANDING_CSS = """
:root{color-scheme:dark}
*,*::before,*::after{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;min-height:100vh;color:#e5e7eb;font:400 16px/1.6 Inter,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;background-color:#080d1a;background-image:radial-gradient(ellipse 80% 50% at 50% -20%,rgba(30,58,138,.22),transparent 70%),radial-gradient(ellipse 60% 40% at 100% 30%,rgba(15,23,42,.4),transparent 60%);background-attachment:fixed}
a{color:#ff8466;text-decoration:none}
a:hover,a:focus-visible{color:#ffb39e;text-decoration:underline}
a:focus-visible{outline:2px solid #ff4d2e;outline-offset:2px;border-radius:4px}
code{font-family:"JetBrains Mono",ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:.92em;font-weight:500}
main,.site-header,.site-footer{width:100%;max-width:60rem;margin:0 auto;padding-left:1rem;padding-right:1rem}
.site-header{display:flex;align-items:center;gap:1rem;padding-top:3rem;padding-bottom:.5rem}
.site-header .logo{display:block;flex:none;width:3rem;height:3rem}
.site-header .logo svg{display:block;width:100%;height:100%}
h1{margin:0;color:#f3f4f6;font-size:clamp(1.6rem,4vw,2.25rem);font-weight:700;letter-spacing:-.02em;line-height:1.2;overflow-wrap:anywhere}
.intro{margin:1rem 0 2rem;color:#9ca3af}
.intro a{color:#ff8466}
table.crates{width:100%;border-collapse:separate;border-spacing:0;overflow:hidden;background:rgba(15,23,42,.72);border:1px solid rgba(255,255,255,.08);border-radius:.75rem}
table.crates th,table.crates td{padding:.85rem 1rem;text-align:left;vertical-align:top;border-bottom:1px solid rgba(255,255,255,.08)}
table.crates tbody tr:last-child td{border-bottom:0}
table.crates th{color:#9ca3af;font-size:.78rem;font-weight:600;letter-spacing:.06em;text-transform:uppercase;background:rgba(12,19,34,.9)}
