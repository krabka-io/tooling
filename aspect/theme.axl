@media (max-width:40rem){table.crates th,table.crates td{padding:.7rem .75rem}table.crates td:first-child{white-space:normal;overflow-wrap:anywhere}.site-header{padding-top:2rem}}
"""

_THEME_SELECTORS = ':root[data-theme="light"],:root:not([data-theme]),:root[data-theme="dark"],:root[data-theme="ayu"]'

