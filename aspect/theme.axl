# The rules below use `:root[data-theme]` or `body.rustdoc` as a prefix. Their
# specificity equals or exceeds the rules they replace, and they come last.
_THEME_RULES = """
body.rustdoc{color-scheme:dark;background-color:#080d1a;background-image:radial-gradient(ellipse 80% 50% at 50% -20%,rgba(30,58,138,.22),transparent 70%),radial-gradient(ellipse 60% 40% at 100% 30%,rgba(15,23,42,.4),transparent 60%);background-attachment:fixed}
body.rustdoc #crate-search,body.rustdoc h1,body.rustdoc h2,body.rustdoc h3,body.rustdoc h4,body.rustdoc h5,body.rustdoc h6,body.rustdoc .sidebar,body.rustdoc rustdoc-topbar,body.rustdoc .search-input,body.rustdoc .search-results .result-name,body.rustdoc .item-table dt>a,body.rustdoc .out-of-band,body.rustdoc .sub-heading,body.rustdoc span.since,body.rustdoc a.src,body.rustdoc rustdoc-toolbar,body.rustdoc summary.hideme,body.rustdoc .scraped-example-list,body.rustdoc .rustdoc-breadcrumbs,body.rustdoc .search-switcher,body.rustdoc ul.all-items{font-family:var(--font-family)}
body.rustdoc kbd{font-family:var(--font-family-code)}
body.rustdoc details.toggle:not([open])>summary .docblock>:first-child::after{font-family:var(--font-family)}
body.rustdoc h1,body.rustdoc h2,body.rustdoc h3,body.rustdoc h4{font-weight:600;letter-spacing:-.01em}
body.rustdoc code,body.rustdoc pre,body.rustdoc .code-header,body.rustdoc .type-signature{font-family:var(--font-family-code)}
body.rustdoc .docblock code,body.rustdoc .item-info code,body.rustdoc .item-table dd code{font-size:.88em}
:root[data-theme] h1,:root[data-theme] h2,:root[data-theme] h3,:root[data-theme] h4,:root[data-theme] h1 a,:root[data-theme] .sidebar h2 a,:root[data-theme] .sidebar h3 a{color:#f3f4f6}
:root[data-theme] .docblock code{color:#ffd4c7}
:root[data-theme] .docblock a>code{color:#ff8466 !important}
:root[data-theme] .code-header,:root[data-theme] .docblock pre>code,:root[data-theme] pre,:root[data-theme] pre>code,:root[data-theme] .item-info code,:root[data-theme] .rustdoc.source .example-wrap{color:#e5e7eb}
:root[data-theme] .sidebar .current,:root[data-theme] .sidebar .current a,:root[data-theme] .sidebar a:hover,:root[data-theme] #src-sidebar div.files>a:hover,:root[data-theme] details.dir-entry summary:hover,:root[data-theme] #src-sidebar div.files>a:focus,:root[data-theme] details.dir-entry summary:focus,:root[data-theme] #src-sidebar div.files>a.selected{color:#ffb39e}
:root[data-theme] .sidebar-elems .location{color:#ff8466}
:root[data-theme] a[data-nosnippet].line-highlighted{color:#ff8466;padding-right:7px;border-right:1px solid #ff4d2e}
:root[data-theme] .search-results a:hover,:root[data-theme] .search-results a:focus{color:#f3f4f6 !important;background-color:#1e293b}
:root[data-theme] .search-results a{color:#ff8466}
:root[data-theme] .search-results a div.desc{color:#9ca3af}
:root[data-theme] .result-name .primitive>i,:root[data-theme] .result-name .keyword>i{color:#9ca3af}
:root[data-theme] #search-tabs>button.selected{border-bottom:1px solid #ff4d2e !important;border-top:none}
:root[data-theme] #search-tabs>button:not(.selected){border:none;background-color:transparent !important}
:root[data-theme] #search-tabs>button:hover{border-bottom:1px solid rgba(255,77,46,.4)}
:root[data-theme] .settings-menu>a img,:root[data-theme] #sidebar-button>a::before{filter:invert(100)}
body.rustdoc a:focus-visible{outline:2px solid #ff4d2e;outline-offset:2px}
"""

def landing_style():
    """The CSS of the landing page and of the per-crate redirect pages.

    The page is self-contained: it links only the Google fonts, and the font
    stack falls back to system fonts when they fail to load. The look is dark
    on every browser setting, because it does not read `prefers-color-scheme`.

    The page builder must produce this structure, and no other class name is
    styled:

        <body>
        <header class="site-header">
          <span class="logo">{krabka_logo_svg()}</span>
          <h1>{repository} API documentation</h1>
        </header>
        <main>
          <p class="intro">Text with optional <a href="...">links</a>.</p>
          <table class="crates">
            <thead><tr><th>Crate</th><th>What it is</th></tr></thead>
            <tbody>
              <tr><td><a href="..."><code>crate-name</code></a></td><td>Description</td></tr>
            </tbody>
          </table>
        </main>
        <footer class="site-footer">
          <p><a href="https://krabka.io/api">Krabka API reference</a></p>
          <p><a href="https://github.com/org/repo">org/repo on GitHub</a></p>
        </footer>
        </body>

    A redirect page uses `<main class="redirect"><p><a href="...">name</a></p></main>`
    in place of the `main` above. It can keep the `site-header` before it.

    The document needs `<meta name="viewport" content="width=device-width, initial-scale=1">`
    and a `<link rel="stylesheet" href="FONTS_URL">` for the fonts: `fonts_url()`
    returns that address.

    Returns:
        The CSS text, without a `style` element around it.
    """
    return _LANDING_CSS.strip() + "\n"

def fonts_url():
    """The Google Fonts stylesheet address for Inter and JetBrains Mono."""
    return _FONTS_URL

def krabka_logo_svg():
    """The Krabka logo as one `svg` element.

    It is the favicon of krabka.io. The element has `viewBox="0 0 90 90"` and
    a width and height of 100%, so the size of its container sets its size.
    """
    return _LOGO_SVG

def rustdoc_theme_css():
    """The override stylesheet that gives rustdoc pages the Krabka look.

    One dark palette replaces the light, dark and ayu themes, so the theme
    picker of rustdoc cannot produce a page that clashes with the site. The
    text contains no `<` character.
    """
    return (
        _THEME_SELECTORS + "{" + "".join(_THEME_VARIABLES.split("\n")) + "}\n" +
        _THEME_RULES.strip() + "\n"
    )

def apply_rustdoc_theme(css_text):
    """The rustdoc stylesheet `css_text` with the Krabka theme added.

    The result starts with the font `@import`, because CSS accepts an
    `@import` only at the start of a stylesheet. It continues with `css_text`
    unchanged, then a marker comment, then `rustdoc_theme_css()`. A stylesheet
    that already holds the marker comes back unchanged.

    Args:
        css_text: The text of a `rustdoc-<hash>.css` file.
    """
    if css_text.find(_MARKER) >= 0:
        return css_text
    return (
        '@import url("' + _FONTS_URL + '");\n' +
        css_text + "\n" +
        _MARKER + "\n" +
        rustdoc_theme_css()
    )

def _is_hashed_file(file_name, prefix, suffix):
    """Whether `file_name` is `<prefix><hex hash><suffix>`."""
    if not file_name.startswith(prefix) or not file_name.endswith(suffix):
        return False
    hash = file_name[len(prefix):len(file_name) - len(suffix)]
    if not hash:
        return False
    for character in hash.elems():
        if character not in "0123456789abcdef":
            return False
    return True

def is_rustdoc_stylesheet(file_name):
    """Whether `file_name` is rustdoc's main stylesheet, `rustdoc-<hash>.css`."""
    return _is_hashed_file(file_name, "rustdoc-", ".css")

def is_favicon_svg(file_name):
    """Whether `file_name` is the rustdoc favicon, `favicon-<hash>.svg`."""
    return _is_hashed_file(file_name, "favicon-", ".svg")
