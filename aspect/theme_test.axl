# The two properties that the override adds to switch the fonts.
_FONT_VARIABLES = ["--font-family", "--font-family-code"]

_STYLESHEET_NAMES = [
    ("rustdoc-77263533.css", True),
    ("rustdoc-0a1b2c3d.css", True),
    ("rustdoc-77263533.css.map", False),
    ("rustdoc-x.css", False),
    ("rustdoc-.css", False),
    ("rustdoc.css", False),
    ("normalize-9960930a.css", False),
    ("noscript-ffcac47a.css", False),
    ("main-7bab91a1.js", False),
    ("favicon-044be391.svg", False),
    ("favicon-32x32-eab170b8.png", False),
    ("README", False),
    ("", False),
]

_FAVICON_NAMES = [
    ("favicon-044be391.svg", True),
    ("favicon-ffffffff.svg", True),
    ("favicon-044be391.svg.map", False),
    ("favicon-.svg", False),
    ("favicon-x.svg", False),
    ("favicon-32x32-eab170b8.png", False),
    ("favicon.svg", False),
    ("rust-logo-9a9549ea.svg", False),
    ("rustdoc-77263533.css", False),
    ("README", False),
    ("", False),
]

_ORIGINALS = [
    "",
    "body{color:#000}",
    ":root[data-theme=\"dark\"]{--main-color:#ddd;}\n",
]

def _tag_problem(svg):
    """The first structure problem of an `svg` element, or "" for none."""
    stack = []
    rest = svg
    for _ in range(len(svg)):
        start = rest.find("<")
        if start < 0:
            break
        end = rest.find(">", start)
        if end < 0:
            return "tag without >"
        tag = rest[start + 1:end]
        rest = rest[end + 1:]
        if tag.startswith("/"):
            if not stack or stack[-1] != tag[1:]:
                return "unbalanced close tag " + tag
            stack.pop()
        elif tag.endswith("/"):
            continue
        else:
            stack.append(tag.split(" ")[0])
    if stack:
        return "unclosed tags %r" % stack
    return ""

def _first_block_names(css):
    """The custom property names of the first `{...}` block of `css`."""
    body = css[css.find("{") + 1:css.find("}")]
    names = []
    for declaration in body.split(";"):
        if declaration.strip():
            names.append(declaration.split(":")[0].strip())
    return names

def _test_is_rustdoc_stylesheet(ctx):
    for file_name, want in _STYLESHEET_NAMES:
        check_eq("is_rustdoc_stylesheet(%r)" % file_name, is_rustdoc_stylesheet(file_name), want)

def _test_is_favicon_svg(ctx):
    for file_name, want in _FAVICON_NAMES:
        check_eq("is_favicon_svg(%r)" % file_name, is_favicon_svg(file_name), want)

def _test_apply_rustdoc_theme_wraps_the_original(ctx):
    for original in _ORIGINALS:
        got = apply_rustdoc_theme(original)
        check("starts with the font import: %r" % got[:40], got.startswith("@import url("))
        head, marker, tail = got.partition(_MARKER)
        import_line, _, kept = head.partition("\n")
        check_eq("import line", import_line, '@import url("%s");' % fonts_url())
        check_eq("original between import and marker", kept, original + "\n")
        check_eq("marker", marker, _MARKER)
        check_eq("override at the end", tail, "\n" + rustdoc_theme_css())

def _test_apply_rustdoc_theme_is_idempotent(ctx):
    for original in _ORIGINALS:
        once = apply_rustdoc_theme(original)
        check_eq("second call", apply_rustdoc_theme(once), once)
        check_eq("marker written once", len(once.split(_MARKER)), 2)

def _test_theme_defines_every_rustdoc_variable(ctx):
    defined = _first_block_names(rustdoc_theme_css())
    check_eq("count", len(_RUSTDOC_VARIABLES), 99)
    check_eq("no variable defined twice", len(defined), len(set(defined)))
    check_eq("defined names", sorted(defined), sorted(_RUSTDOC_VARIABLES + _FONT_VARIABLES))

def _test_theme_covers_every_rustdoc_theme_name(ctx):
    css = rustdoc_theme_css()
    selectors = css[:css.find("{")].split(",")
    check_eq(
        "selector list",
        selectors,
        [
            ':root[data-theme="light"]',
            ":root:not([data-theme])",
            ':root[data-theme="dark"]',
            ':root[data-theme="ayu"]',
        ],
    )

def _test_style_sheets_cannot_break_out_of_a_style_element(ctx):
    for label, css in [
        ("rustdoc_theme_css", rustdoc_theme_css()),
        ("landing_style", landing_style()),
        ("apply_rustdoc_theme", apply_rustdoc_theme("")),
    ]:
        check_eq("%s has no <" % label, css.find("<"), -1)

def _test_style_sheet_braces_balance(ctx):
    for label, css in [
        ("rustdoc_theme_css", rustdoc_theme_css()),
        ("landing_style", landing_style()),
    ]:
        check_eq("%s braces" % label, css.count("{"), css.count("}"))
        check_eq("%s parentheses" % label, css.count("("), css.count(")"))

def _test_landing_style_keeps_the_dark_page_background(ctx):
    check(
        "landing background",
        "background-color:#080d1a" in landing_style(),
    )
    check("landing ends with a newline", landing_style().endswith("\n"))

def _test_landing_style_stacks_the_crate_rows_on_phones(ctx):
    phone = landing_style().split("@media (max-width:40rem){")[1]
    check("rows are blocks", "table.crates tr,table.crates td{display:block}" in phone)
    check("header row is hidden", "table.crates thead{display:none}" in phone)

def _test_theme_hides_the_dead_theme_settings(ctx):
    css = rustdoc_theme_css()
    for row in ["#theme", "#preferred-light-theme", "#preferred-dark-theme"]:
        check("%s row" % row, "body.rustdoc %s" % row in css)

def _test_fonts_url_names_both_families(ctx):
    url = fonts_url()
    check("https", url.startswith("https://fonts.googleapis.com/css2?"))
    check("Inter", "family=Inter:" in url)
    check("JetBrains Mono", "family=JetBrains+Mono:" in url)

def _test_krabka_logo_svg_is_one_well_formed_element(ctx):
    svg = krabka_logo_svg()
    check("starts with svg", svg.startswith("<svg "))
    check("ends with svg", svg.endswith("</svg>"))
    check_eq("one svg element", svg.count("<svg"), 1)
    check_eq("structure", _tag_problem(svg), "")
    check("brand colour", "#FF4D2E" in svg)
    check("no XML declaration", "<?" not in svg)
    check("no comment", "<!--" not in svg)

theme_tests = suite("theme", [
    _test_is_rustdoc_stylesheet,
    _test_is_favicon_svg,
    _test_apply_rustdoc_theme_wraps_the_original,
    _test_apply_rustdoc_theme_is_idempotent,
    _test_theme_defines_every_rustdoc_variable,
    _test_theme_covers_every_rustdoc_theme_name,
    _test_style_sheets_cannot_break_out_of_a_style_element,
    _test_style_sheet_braces_balance,
    _test_landing_style_keeps_the_dark_page_background,
    _test_landing_style_stacks_the_crate_rows_on_phones,
    _test_theme_hides_the_dead_theme_settings,
    _test_fonts_url_names_both_families,
    _test_krabka_logo_svg_is_one_well_formed_element,
])

test_theme = suite_task(theme_tests)
