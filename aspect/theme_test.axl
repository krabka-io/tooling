"""Unit tests for `theme.axl`."""

load(
    "./theme.axl",
    "apply_rustdoc_theme",
    "fonts_url",
    "is_favicon_svg",
    "is_rustdoc_stylesheet",
    "krabka_logo_svg",
    "landing_style",
    "rustdoc_theme_css",
)
load("./testing.axl", "check", "check_eq", "suite", "suite_task")

_MARKER = "/* krabka-theme */"

# Every custom property in the dark block of rustdoc 1.94, in file order. The
# override has to define each one, or that property keeps a light value under
